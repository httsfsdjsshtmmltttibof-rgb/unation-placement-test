# UNATION English Placement Test - Server Configuration
PORT=3001
NODE_ENV=development

# Supabase Credentials (from your Supabase project -> Settings -> API)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Admin Authentication
ADMIN_USERNAME=admin
# Use `npm run setup-admin <your-password>` in the backend directory to generate this hash
ADMIN_PASSWORD_HASH=$2a$12$K1H1eP921lD1vVb0pQZ19eYp16pCsuuK0eM8xUeQkQ7t8fF/y.2aK
JWT_SECRET=unation_super_secret_jwt_placement_test_token_2026_change_me

# Client Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Optional: Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
